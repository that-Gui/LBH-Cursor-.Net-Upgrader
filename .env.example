# Copy to .env (gitignored). A real environment variable always wins over the file.
# Use a fine-grained PAT or GitHub App token scoped to this org:
# contents: read/write, pull-requests: write. Do not use `gh auth token`.

GITHUB_ORG=my-org
GITHUB_TOKEN=github_pat_...

# Optional. Defaults shown.
# WORK_DIR=./work
# BATCH_SIZE=4
# ACTIVE_MONTHS=12
# CODE_OWNERS=0
